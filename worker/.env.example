# Worker Gemini configuration
# Copy values into your real worker environment. Do not commit live secrets.

GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Grok Imagine (xAI) — used on testing-grok-imagine branch for Stage 1A/1B/2
# generation + validation instead of Gemini.
XAI_API_KEY=YOUR_XAI_API_KEY_HERE
GROK_IMAGE_MODEL=grok-imagine-image-quality
GROK_VISION_MODEL=grok-4.5

# Stage 2 (virtual staging) prompt variant. Default (unset) = "legacy" NZ real-estate prompt.
# "nano" = prompt written for Google's Gemini nano-banana image model.
# "grok" = prompt derived from the NZ property image staging skill, written for Grok.
STAGE2_PROMPT_VARIANT=grok

# Stage 1A (photo enhancement) prompt variant. Default (unset or "gemini") = existing
# Gemini-oriented NZ real-estate prompt (still sent to Grok on this branch, unchanged).
# "grok" = leaner interior/exterior prompts written for Grok's image-edit behavior.
STAGE1A_PROMPT_VARIANT=grok

# Stage 2 specialist validators (opening/fixture/floor/envelope). Default (unset or "true")
# = run all four real specialists via Gemini, awaiting structural baseline extraction before
# the opening validator runs. Set to "off"/"false"/"0" to skip them entirely — Unified
# Validator still runs and still compares the Stage 2 output directly against the Stage 1A
# baseline either way.
STAGE2_SPECIALIST_VALIDATORS=true
# Optional tuning (defaults shown):
# STAGE2_SPECIALIST_EXEC_RETRIES=1
# STAGE2_SPECIALIST_EXEC_TIMEOUT_MS=45000
# STAGE2_SPECIALIST_OPENING_TIMEOUT_MS=90000

# Corrective 2-image retry: when attempt 1 fails with a geometry-class structural
# violation (STRUCTURAL_DISTORTION, STRUCTURAL_INVARIANT, CATASTROPHIC_ORIENTATION),
# retry 1 edits the flawed attempt-1 candidate directly (grounded against the original
# baseline photo as a second reference image) instead of blindly regenerating from
# scratch. Default (unset or "true") = on. Set to "off"/"false"/"0" to revert to the
# original blind full-regeneration retry for all failure types.
STAGE2_CORRECTIVE_RETRY=true

# Reduced runtime logging for production while keeping structured audit output.
PRODUCTION_LOG_MODE=false

# Optional: self-costing usage logs
# When these are set, [USAGE] logs include costEstimateUsd.
# If a model is missing pricing, costEstimateUsd will be null for that model.
#
# Variable format:
# GEMINI_PRICE_<MODEL>_INPUT_USD_PER_1M_TOKENS
# GEMINI_PRICE_<MODEL>_OUTPUT_USD_PER_1M_TOKENS
#
# Model normalization rule:
# - uppercase the model name
# - replace non-alphanumeric characters with underscores
#
# Examples:
# gemini-2.5-flash-image      -> GEMINI_2_5_FLASH_IMAGE
# gemini-3-pro-image-preview  -> GEMINI_3_PRO_IMAGE_PREVIEW
# gemini-2.5-flash            -> GEMINI_2_5_FLASH
# gemini-2.5-pro              -> GEMINI_2_5_PRO
# gemini-2.0-flash            -> GEMINI_2_0_FLASH

GEMINI_PRICE_GEMINI_2_5_FLASH_IMAGE_INPUT_USD_PER_1M_TOKENS=
GEMINI_PRICE_GEMINI_2_5_FLASH_IMAGE_OUTPUT_USD_PER_1M_TOKENS=

GEMINI_PRICE_GEMINI_3_PRO_IMAGE_PREVIEW_INPUT_USD_PER_1M_TOKENS=
GEMINI_PRICE_GEMINI_3_PRO_IMAGE_PREVIEW_OUTPUT_USD_PER_1M_TOKENS=

GEMINI_PRICE_GEMINI_2_5_FLASH_INPUT_USD_PER_1M_TOKENS=
GEMINI_PRICE_GEMINI_2_5_FLASH_OUTPUT_USD_PER_1M_TOKENS=

GEMINI_PRICE_GEMINI_2_5_PRO_INPUT_USD_PER_1M_TOKENS=
GEMINI_PRICE_GEMINI_2_5_PRO_OUTPUT_USD_PER_1M_TOKENS=

GEMINI_PRICE_GEMINI_2_0_FLASH_INPUT_USD_PER_1M_TOKENS=
GEMINI_PRICE_GEMINI_2_0_FLASH_OUTPUT_USD_PER_1M_TOKENS=