# Worker Gemini configuration
# Copy values into your real worker environment. Do not commit live secrets.

GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── Vertex mask-constrained inpainting Stage 2 provider (feature/vertex-mask-inpainting) ──
# Default (unset, or any value other than "vertex_inpaint") = existing Gemini/Grok
# Stage 2 path, completely unchanged. Set to "vertex_inpaint" to route Stage 2
# through: Gemini single-image furniture-placement mask -> Vertex Imagen
# EDIT_MODE_INPAINT_INSERTION -> outside-mask drift validation. See
# VERTEX_INPAINTING_INVESTIGATION.md for full background.
STAGE2_RENDER_PROVIDER=gemini

# Vertex AI (Application Default Credentials) — required only when
# STAGE2_RENDER_PROVIDER=vertex_inpaint. Do not commit real values.
GOOGLE_CLOUD_PROJECT=YOUR_GCP_PROJECT_ID_HERE
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/tmp/gcp-key.json
GOOGLE_APPLICATION_CREDENTIALS_JSON=YOUR_SERVICE_ACCOUNT_JSON_HERE

# Vertex Imagen model — must support reference-image inpainting.
VERTEX_INPAINT_MODEL=imagen-3.0-capability-001
# Gemini model used for the single-image furniture-placement mask (must support image output).
VERTEX_INPAINT_MASK_MODEL=gemini-2.5-flash-image

# Outside-mask structural drift thresholds — the primary safety gate for this
# path (VERTEX_INPAINTING_INVESTIGATION.md §13). Defaults match the proven
# values from feature/vertex-secondary-inpainting-continuity.
VERTEX_INPAINT_OUTSIDE_MASK_MAX_MAE=6
VERTEX_INPAINT_OUTSIDE_MASK_MAX_CHANGED_RATIO=0.035
VERTEX_INPAINT_OUTSIDE_MASK_CHANGE_THRESHOLD=18

# Optional: self-costing usage logs
# When these are set, [USAGE] logs include costEstimateUsd.
# If a model is missing pricing, costEstimateUsd will be null for that model.
#
# Variable format:
# GEMINI_PRICE_<MODEL>_INPUT_USD_PER_1M_TOKENS
# GEMINI_PRICE_<MODEL>_OUTPUT_USD_PER_1M_TOKENS
#
# Model normalization rule:
# - uppercase the model name
# - replace non-alphanumeric characters with underscores
#
# Examples:
# gemini-2.5-flash-image      -> GEMINI_2_5_FLASH_IMAGE
# gemini-3-pro-image-preview  -> GEMINI_3_PRO_IMAGE_PREVIEW
# gemini-2.5-flash            -> GEMINI_2_5_FLASH
# gemini-2.5-pro              -> GEMINI_2_5_PRO
# gemini-2.0-flash            -> GEMINI_2_0_FLASH

GEMINI_PRICE_GEMINI_2_5_FLASH_IMAGE_INPUT_USD_PER_1M_TOKENS=
GEMINI_PRICE_GEMINI_2_5_FLASH_IMAGE_OUTPUT_USD_PER_1M_TOKENS=

GEMINI_PRICE_GEMINI_3_PRO_IMAGE_PREVIEW_INPUT_USD_PER_1M_TOKENS=
GEMINI_PRICE_GEMINI_3_PRO_IMAGE_PREVIEW_OUTPUT_USD_PER_1M_TOKENS=

GEMINI_PRICE_GEMINI_2_5_FLASH_INPUT_USD_PER_1M_TOKENS=
GEMINI_PRICE_GEMINI_2_5_FLASH_OUTPUT_USD_PER_1M_TOKENS=

GEMINI_PRICE_GEMINI_2_5_PRO_INPUT_USD_PER_1M_TOKENS=
GEMINI_PRICE_GEMINI_2_5_PRO_OUTPUT_USD_PER_1M_TOKENS=

GEMINI_PRICE_GEMINI_2_0_FLASH_INPUT_USD_PER_1M_TOKENS=
GEMINI_PRICE_GEMINI_2_0_FLASH_OUTPUT_USD_PER_1M_TOKENS=